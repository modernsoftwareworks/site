---
import BrandMark from '../components/brand/BrandMark.astro';
import { messages } from '../i18n/messages';
import LaunchLayout from '../layouts/LaunchLayout.astro';

const t = messages.en;
---

<LaunchLayout locale="en" messages={{ ...t, title: t.notFoundTitle }} noindex staticField>
  <div class="fallback" data-od-id="webgl-fallback"></div>
  <div class="shell" id="top">
    <header class="top">
      <a class="brand" href="/" aria-label={t.brandAria} translate="no">
        <BrandMark />
        <strong class="wordmark">{t.brandName}</strong>
      </a>
    </header>
    <main class="stage">
      <div class="copy">
        <h1 class="headline">{t.notFoundHeadline}</h1>
        <div class="cta-wrap">
          <a class="cta" href="/">{t.notFoundHome}</a>
        </div>
      </div>
    </main>
  </div>
</LaunchLayout>
