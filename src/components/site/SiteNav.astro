---
import { type Locale, localePath } from '../../i18n/locales';
import { type Messages, mailHref } from '../../i18n/schema';
import BrandMark from '../brand/BrandMark.astro';
import LangSwitcher from '../i18n/LangSwitcher.astro';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages: t } = Astro.props;

// Anchored to the locale home rather than bare fragments, so the bar still
// works on pages that do not carry the bands — 404, chiefly.
const home = localePath(locale);
const sections = [
  { href: `${home}#services`, label: t.navServices },
  { href: `${home}#method`, label: t.navMethod },
  { href: `${home}#why`, label: t.navWhy },
  { href: `${home}#international`, label: t.navIntl },
];
---

<header class="nav">
  <a class="lockup" href={home} dir="ltr" aria-label={t.brandAria} translate="no">
    <span class="lockup-mark"><BrandMark /></span>
    <span class="wordmark">Modern Software Works<span class="dot">.</span></span>
  </a>

  <div class="tail">
    <nav class="sections" aria-label={t.navServices}>
      {sections.map((section) => (
          <a class="section-link" href={section.href}>
            {section.label}
          </a>
        ))}
    </nav>
    <span class="langs-slot"><LangSwitcher locale={locale} messages={t} /></span>
    <a class="mail" href={mailHref()}>{t.navEmail}</a>
  </div>
</header>

<style>
  /* min-height pinned to --nav-h makes the token true by construction: every
     band's `calc(100svh - var(--nav-h))` and scroll-padding-top then match the
     bar that is actually on screen. The bar must therefore never wrap, which is
     what the nowrap and the breakpoints below are for. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-h);
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(10px);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--ink);
    --mark-size: 34px;
  }

  .lockup-mark {
    display: inline-flex;
    transition: transform var(--t-spin) var(--ease);
  }

  .wordmark {
    font: 600 17px var(--stack-display);
    letter-spacing: var(--tracking-wordmark);
    white-space: nowrap;
  }

  .dot {
    color: var(--accent-text);
  }

  .tail {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 13.5px;
    font-weight: 700;
  }

  .sections {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .section-link {
    color: var(--ink);
  }

  .langs-slot {
    display: inline-flex;
  }

  /* In the bar the pills must never wrap — a second row would put the real
     height above --nav-h. In the footer they are free to. */
  .langs-slot :global(.langs) {
    flex-wrap: nowrap;
  }

  .mail {
    color: var(--ink);
    background: var(--wash);
    padding: 8px 16px;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      background var(--t-quick),
      color var(--t-quick);
  }

  @media (hover: hover) {
    .lockup:hover .lockup-mark {
      transform: rotate(-8deg) scale(1.12);
    }

    .section-link:hover {
      color: var(--accent-text);
    }

    .mail:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* The anchors are the first thing to go: they only shortcut to bands the page
     scrolls through anyway. */
  @media (max-width: 1100px) {
    .sections {
      display: none;
    }
  }

  /* One compact row below 900px. The five locale pills move to the footer —
     together with the anchors they were costing up to 70px of every screen. */
  @media (max-width: 900px) {
    .nav {
      gap: 12px;
      padding-block: 7px;
    }

    .langs-slot {
      display: none;
    }

    .lockup,
    .mail {
      min-height: 44px;
    }

    .mail {
      display: inline-flex;
      align-items: center;
    }

    .lockup {
      --mark-size: 26px;
    }

    .wordmark {
      font-size: 14px;
    }

    .tail {
      gap: 12px;
      font-size: 13px;
    }
  }

  @media (max-width: 420px) {
    .mail {
      padding: 8px 14px;
    }
  }

  /* Narrower than this the wordmark cannot share the row with the longest
     locale's CTA without wrapping, and a wrapped bar breaks --nav-h. The
     monogram carries the brand alone; the link keeps its aria-label. */
  @media (max-width: 359px) {
    .wordmark {
      display: none;
    }
  }
</style>
