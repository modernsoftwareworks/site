---
import { type Locale, localeDir, localePath } from '../../i18n/locales';
import type { Messages } from '../../i18n/schema';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages: t } = Astro.props;

/** Each card speaks its own language, so the copy is fixed rather than translated. */
const CARDS: Record<Locale, { region: string; greeting: string; action: string }> = {
  en: {
    region: 'ENGLISH · INTERNATIONAL',
    greeting: 'Welcome.',
    action: 'Read the site in English →',
  },
  it: {
    region: 'ITALIANO · ITALIA',
    greeting: 'Benvenuti.',
    action: 'Leggi il sito in italiano →',
  },
  fr: { region: 'FRANÇAIS · FRANCE', greeting: 'Bienvenue.', action: 'Lire le site en français →' },
  ja: { region: '日本語 · 日本', greeting: 'ようこそ。', action: '日本語で表示 →' },
  ar: { region: 'العربية · السعودية', greeting: 'أهلاً بكم.', action: 'اعرض الموقع بالعربية ←' },
};

// Four cards, as designed. Never link to the page you are already on: when a
// card's locale is the current one, English takes its slot.
const shown: Locale[] = (['it', 'fr', 'ja', 'ar'] as const).map((code) =>
  code === locale ? 'en' : code,
);
---

<section id="international" class="band intl">
  <div class="head reveal">
    <h2>{t.intlH2a}<br>{t.intlH2b}</h2>
    <p>{t.intlLede}</p>
  </div>

  <div class="grid">
    {shown.map((code) => (
        <a
          class="card"
          href={localePath(code)}
          hreflang={code}
          lang={code}
          dir={localeDir[code]}
          data-lang={code}
        >
          <span class="region" dir="ltr">{CARDS[code].region}</span>
          <span class:list={['greeting', code]}>{CARDS[code].greeting}</span>
          <span class:list={['action', code]}>{CARDS[code].action}</span>
        </a>
      ))}
  </div>
</section>

<script>
  import { persistLocaleOnSwitch } from '../../scripts/locale-preference';

  persistLocaleOnSwitch();
</script>

<style>
  .intl {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .head {
    padding: clamp(32px, 5vh, 72px) var(--gutter) clamp(16px, 3vh, 24px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(20px, 3vw, 48px);
    flex-wrap: wrap;
  }

  h2 {
    margin: 0;
    font: 600 var(--step-h2) / 1.1 var(--stack-display);
    letter-spacing: var(--tracking-h2);
  }

  .head p {
    margin: 0 0 8px;
    font-size: var(--step-lede);
    line-height: 1.65;
    color: var(--muted);
    max-width: 440px;
    text-wrap: pretty;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1px;
    background: var(--ink);
    border-top: 1px solid var(--ink);
  }

  .card {
    padding: clamp(22px, 3vh, 32px) clamp(20px, 3vw, 40px);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink);
    transition: background var(--t-quick);
  }

  @media (hover: hover) {
    .card:hover {
      background: var(--paper-2);
      color: var(--ink);
    }
  }

  .region {
    font: 700 11px var(--stack-mono);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--accent-text);
    text-align: start;
  }

  .card[dir="rtl"] .region {
    text-align: end;
  }

  .greeting {
    font: 600 22px / 1.25 var(--stack-display);
  }

  .greeting.ja {
    font:
      500 22px / 1.4 var(--font-jp-serif, serif),
      serif;
  }

  .greeting.ar {
    font:
      500 22px / 1.5 var(--font-ar, serif),
      serif;
  }

  .action {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-text);
  }

  .action.ar {
    font-family: var(--font-ar, serif), serif;
  }
</style>
