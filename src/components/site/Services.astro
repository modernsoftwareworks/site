---
import type { Locale } from '../../i18n/locales';
import type { Messages } from '../../i18n/schema';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages: t } = Astro.props;

const numerals =
  locale === 'ar' ? ['٠١', '٠٢', '٠٣', '٠٤', '٠٥', '٠٦'] : ['01', '02', '03', '04', '05', '06'];
---

<section id="services" class="band services">
  <div class="services-head reveal">
    <h2 class="services-h2">{t.servicesH2}</h2>
    <p class="services-lede">{t.servicesLede}</p>
  </div>

  <ul class="list">
    {t.services.map((service, index) => (
        <li class="row" data-spotlight style={`--row-i: ${index}`}>
          <span class="n">{numerals[index]}</span>
          <h3 class="title">{service.title}</h3>
          <div class="body">
            <p class="detail">{service.detail}</p>
            <p class="audience">{service.audience}</p>
          </div>
          <span class="glyph" aria-hidden="true">✦</span>
        </li>
      ))}
  </ul>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .services-head {
    padding: clamp(28px, 4.5vh, 64px) var(--gutter) clamp(18px, 3vh, 36px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(20px, 3vw, 48px);
    flex-wrap: wrap;
  }

  .services-h2 {
    margin: 0;
    font: 600 var(--step-h2) / 1.1 var(--stack-display);
    letter-spacing: var(--tracking-h2);
  }

  .services-lede {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 380px;
    text-wrap: pretty;
  }

  /* 1px gaps over an ink ground draw the hairlines between rows. */
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--ink);
    border-top: 1px solid var(--ink);
  }

  .row {
    background: var(--surface-card);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px clamp(24px, 4vw, 56px);
    padding: clamp(16px, 2.3vh, 26px) var(--gutter);
    transition:
      background var(--t-quick),
      padding-inline-start var(--t-slide) var(--ease);
    animation: var(--anim-reveal) 0.7s var(--ease) both;
    animation-delay: calc(var(--row-i, 0) * 0.05s);
    animation-timeline: view();
    animation-range: entry 0% entry 35%;
  }

  .n {
    flex: 0 0 auto;
    font: 700 12px var(--stack-mono);
    color: var(--accent-text);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--paper-2);
    transition:
      background var(--t-quick),
      color var(--t-quick),
      border-color var(--t-quick);
  }

  .title {
    flex: 1 1 min(100%, 240px);
    min-width: 0;
    margin: 0;
    font: 600 var(--step-h3) var(--stack-display);
    position: relative;
    z-index: 1;
  }

  .body {
    flex: 2 1 min(100%, 340px);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 1;
  }

  .detail {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 62ch;
  }

  .audience {
    margin: 0;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent-text);
  }

  .glyph {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 14px;
    opacity: 0.35;
    transition:
      transform var(--t-spin) var(--ease),
      opacity var(--t-quick);
  }

  /* Gated: on a touch screen :hover latches after a tap and the row would
     stay tinted and indented for the rest of the session. */
  @media (hover: hover) {
    .row:hover {
      background: var(--surface-card-hover);
      padding-inline-start: clamp(32px, 5vw, 84px);
    }

    .row:hover .n {
      background: var(--accent);
      color: var(--paper);
      border-color: var(--accent);
    }

    .row:hover .glyph {
      opacity: 1;
      transform: rotate(90deg) scale(1.25);
    }
  }

  @media (max-width: 720px) {
    .glyph {
      display: none;
    }
  }
</style>
