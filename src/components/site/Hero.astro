---
import type { Messages } from '../../i18n/schema';
import { mailHref } from '../../i18n/schema';
import BrandMark from '../brand/BrandMark.astro';

interface Props {
  messages: Messages;
}

const { messages: t } = Astro.props;

// The track is duplicated so translateX(-50%) loops seamlessly.
const marquee = [...t.services, ...t.services];
---

<section id="top" class="hero">
  <div class="stage">
    <div class="copy">
      <p class="eyebrow">
        <span class="eyebrow-pulse" aria-hidden="true"></span>
        <span>{t.overline}</span>
      </p>

      <h1 class="headline">
        <span class="clip"><span class="line a">{t.h1a}</span></span>
        <span class="clip"
          ><span class="line b"><em>{t.h1b}</em></span></span
        >
      </h1>
      <p class="lede">{t.lede}</p>
      <div class="ctas">
        <a class="cta primary" data-magnetic="0.28" href={mailHref(t.inquirySubject)}>
          <span>{t.cta1}</span>
          <span class="cta-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cta ghost" data-magnetic="0.22" href="#services">{t.cta2}</a>
      </div>
    </div>

    <div class="mark-stage" data-tilt>
      <div class="mark-orb">
        <div class="fractal-halo" data-tilt-orbits aria-hidden="true">
          <svg class="halo-svg cw" viewBox="0 0 400 400" fill="none" aria-hidden="true">
            <circle
              cx="200"
              cy="200"
              r="182"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray="4 8"
            ></circle>
            <circle
              cx="200"
              cy="200"
              r="148"
              stroke="currentColor"
              stroke-width="0.85"
              opacity="0.65"
            ></circle>
            <polygon
              points="200,26 350,113 350,287 200,374 50,287 50,113"
              stroke="currentColor"
              stroke-width="0.85"
              opacity="0.45"
            ></polygon>
            <polygon
              points="200,26 350,287 50,287"
              stroke="currentColor"
              stroke-width="0.7"
              opacity="0.3"
            ></polygon>
            <polygon
              points="200,374 350,113 50,113"
              stroke="currentColor"
              stroke-width="0.7"
              opacity="0.3"
            ></polygon>
            <circle cx="200" cy="18" r="3.5" fill="var(--accent)"></circle>
            <circle cx="382" cy="200" r="3" fill="var(--accent)"></circle>
            <circle cx="18" cy="200" r="3" fill="var(--accent)"></circle>
          </svg>

          <svg class="halo-svg ccw" viewBox="0 0 400 400" fill="none" aria-hidden="true">
            <ellipse
              cx="200"
              cy="200"
              rx="168"
              ry="82"
              transform="rotate(30 200 200)"
              stroke="currentColor"
              stroke-width="0.9"
              opacity="0.45"
            ></ellipse>
            <ellipse
              cx="200"
              cy="200"
              rx="168"
              ry="82"
              transform="rotate(90 200 200)"
              stroke="currentColor"
              stroke-width="0.9"
              opacity="0.45"
            ></ellipse>
            <ellipse
              cx="200"
              cy="200"
              rx="168"
              ry="82"
              transform="rotate(150 200 200)"
              stroke="currentColor"
              stroke-width="0.9"
              opacity="0.45"
            ></ellipse>
            <rect
              x="88"
              y="88"
              width="224"
              height="224"
              transform="rotate(45 200 200)"
              stroke="currentColor"
              stroke-width="0.75"
              stroke-dasharray="3 6"
              opacity="0.4"
            ></rect>
          </svg>
        </div>

        <div class="mark-float">
          <span class="mark-wrap" data-tilt-target><BrandMark /></span>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee" dir="ltr" aria-hidden="true">
    <div class="track">
      {marquee.map((service) => (
          <span class="item">
            <span class="item-text">{service.title}</span>
            <span class="star">✦</span>
          </span>
        ))}
    </div>
  </div>
</section>

<script>
  import { mountTilt } from '../../scripts/tilt';

  mountTilt();
</script>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    border-bottom: 1px solid var(--ink);
    background: linear-gradient(180deg, var(--surface-band) 35%, var(--surface-band-alt) 100%);
    position: relative;
    overflow: hidden;
  }

  .stage {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(min(100%, 240px), 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(32px, 5vh, 72px) var(--gutter);
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    animation: var(--anim-rise) 0.8s var(--ease) both;
    margin: 0 0 clamp(14px, 2vh, 22px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface-card);
    font: 700 11px var(--stack-mono);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--accent-text);
    backdrop-filter: blur(10px);
  }

  .eyebrow-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .headline {
    margin: 0;
    font: 600 var(--step-h1) / 1.04 var(--stack-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  /* Masks the `rise` keyframe's translateY(110%). The clip margin keeps the
     highlight pill's rounded box from being shaved at small sizes without
     revealing the line before it arrives. */
  .clip {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }

  .clip + .clip {
    margin-top: 4px;
  }

  .line {
    display: block;
    animation: var(--anim-rise) 0.9s var(--ease) both;
  }

  .line.a {
    animation-delay: 0.05s;
  }

  .line.b {
    animation-delay: 0.18s;
  }

  .line em {
    font-style: normal;
    background: linear-gradient(
      125deg,
      var(--wash) 0%,
      color-mix(in srgb, var(--accent) 26%, var(--wash)) 50%,
      var(--wash) 100%
    );
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    padding: 2px 18px;
    border-radius: 16px;
    display: inline-block;
    box-shadow: 0 10px 30px -10px var(--mark-glow);
  }

  .lede {
    animation: var(--anim-rise) 0.9s var(--ease) 0.32s both;
    margin: clamp(20px, 3.5vh, 36px) 0 0;
    font-size: var(--step-lede);
    line-height: 1.65;
    color: var(--muted);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .ctas {
    animation: var(--anim-rise) 0.9s var(--ease) 0.45s both;
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: clamp(20px, 3.5vh, 34px);
  }

  .cta {
    padding: 16px 30px;
    font-weight: 700;
    font-size: 15px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
      transform var(--t-lift) var(--ease),
      translate var(--t-quick) ease-out,
      background var(--t-lift),
      color var(--t-lift),
      box-shadow var(--t-lift);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform var(--t-quick) var(--ease);
  }

  .primary {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 10px 26px -8px var(--mark-glow);
  }

  .ghost {
    color: var(--ink);
    padding-inline: 26px;
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    backdrop-filter: blur(8px);
  }

  .mark-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 900px;
  }

  .mark-orb {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(240px, 31vw, 430px);
    height: clamp(240px, 31vw, 430px);
  }

  .fractal-halo {
    position: absolute;
    inset: 0;
    color: var(--accent);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--t-quick) ease-out;
  }

  .halo-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .halo-svg.cw {
    animation: var(--anim-orbit-cw) 48s linear infinite;
  }

  .halo-svg.ccw {
    animation: var(--anim-orbit-ccw) 34s linear infinite;
  }

  .mark-float {
    position: relative;
    z-index: 1;
    animation: var(--anim-floaty) 7s ease-in-out infinite;
  }

  .mark-wrap {
    display: inline-flex;
    --mark-size: clamp(165px, 20vw, 300px);
    color: var(--ink);
    filter: drop-shadow(0 24px 42px var(--mark-glow));
    transition: transform var(--t-quick) ease-out;
    will-change: transform;
  }

  .marquee {
    border-top: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding: 13px 0;
    white-space: nowrap;
    position: relative;
    z-index: 1;
  }

  .track {
    display: inline-flex;
    gap: 48px;
    animation: var(--anim-marquee) 28s linear infinite;
    padding-inline-end: 48px;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 48px;
  }

  .item-text {
    font: 500 14px var(--stack-display);
    letter-spacing: var(--tracking-marquee);
  }

  .star {
    color: var(--accent);
    display: inline-block;
    animation: var(--anim-orbit-cw) 10s linear infinite;
  }

  @media (hover: hover) {
    .primary:hover {
      background: var(--accent);
      color: var(--paper);
      transform: translateY(-3px);
      box-shadow: 0 16px 34px -6px var(--mark-glow);
    }

    .primary:hover .cta-arrow {
      transform: translate(3px, -3px);
    }

    .ghost:hover {
      background: var(--paper-2);
      color: var(--ink);
      transform: translateY(-3px);
    }

    .marquee:hover .track {
      animation-play-state: paused;
    }
  }

  @media (max-width: 900px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(20px, 5vh, 40px);
    }

    .mark-stage {
      order: -1;
      justify-content: flex-start;
    }

    .mark-orb {
      width: clamp(144px, 4.5rem + 18vw, 240px);
      height: clamp(144px, 4.5rem + 18vw, 240px);
    }

    .mark-wrap {
      --mark-size: clamp(96px, 3rem + 12vw, 164px);
    }

    .hero {
      min-height: 0;
    }

    .stage {
      flex: none;
      padding-block: clamp(28px, 6vw, 56px);
    }
  }

  @media (max-width: 480px) {
    .ctas {
      gap: 10px;
    }

    .cta {
      flex: 1 1 100%;
      text-align: center;
    }
  }
</style>
