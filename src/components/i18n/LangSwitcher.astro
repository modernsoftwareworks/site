---
import { type Locale, localeLabels, localePath, locales } from '../../i18n/locales';
import type { Messages } from '../../i18n/schema';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
---

<nav class="langs" aria-label={messages.langLabel}>
  {locales.map((code) => (
      <a
        class:list={['pill', { current: code === locale }]}
        href={localePath(code)}
        hreflang={code}
        lang={code}
        data-lang={code}
        data-astro-prefetch={code === locale ? 'false' : 'hover'}
        aria-current={code === locale ? 'page' : undefined}
      >
        {localeLabels[code]}
      </a>
    ))}
</nav>

<script>
  import { persistLocaleOnSwitch } from '../../scripts/locale-preference';

  persistLocaleOnSwitch();
</script>

<style>
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .pill {
    font: 700 11px var(--stack-mono);
    padding: 5px 9px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    color: var(--muted);
    user-select: none;
    white-space: nowrap;
    transition:
      background var(--t-quick),
      color var(--t-quick),
      border-color var(--t-quick);
  }

  @media (hover: hover) {
    .pill:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }

  @media (pointer: coarse) {
    .pill {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-block: 0;
    }
  }

  .pill.current {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
</style>
