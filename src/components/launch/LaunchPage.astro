---
import { type Locale, localePath } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
import { mailHref } from '../../i18n/schema';
import LaunchLayout from '../../layouts/LaunchLayout.astro';
import BrandMark from '../brand/BrandMark.astro';
import LangSwitcher from '../i18n/LangSwitcher.astro';
import AuroraField from './AuroraField.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const href = mailHref(t);
const home = localePath(locale);
---

<LaunchLayout locale={locale} messages={t}>
  <a class="skip" href="#write" data-od-id="skip-write" data-astro-prefetch="false">{t.skip}</a>

  <AuroraField />

  <p class="sr-only" id="lang-status" data-od-id="lang-status" aria-live="polite">{t.langSpoken}</p>

  <div class="shell" id="top" data-od-id="launch-overlay">
    <header class="top">
      <a class="brand" href={home} data-od-id="brand-mark" aria-label={t.brandAria} translate="no">
        <BrandMark />
        <strong class="wordmark">{t.brandName}</strong>
      </a>
      <LangSwitcher locale={locale} messages={t} />
    </header>

    <main class="stage">
      <div class="copy">
        <h1 class="headline" data-od-id="headline">{t.headline}</h1>
        <p class="deck" data-od-id="deck">{t.deck}</p>
        <div class="cta-wrap">
          <a class="cta" id="write" href={href} data-od-id="cta-inquire" data-astro-prefetch="false"
            >{t.cta}</a
          >
          <a class="cta-note" href={href} data-od-id="cta-note" data-astro-prefetch="false"
            >{t.ctaNote}</a
          >
        </div>
      </div>
    </main>
  </div>

  <script is:inline define:vars={{ locale }}>
    try {
      localStorage.setItem('msw-lang', locale);
    } catch {
      // Private mode or blocked storage.
    }
  </script>
</LaunchLayout>
