{
  "name": "modernsoftware-works",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "deadcode": "fallow dead-code",
    "og": "bun scripts/render-og.mjs",
    "test": "vitest run",
    "verify": "astro check && biome check . && fallow dead-code && vitest run && astro build",
    "deploy": "astro build && wrangler deploy",
    "prepare": "lefthook install"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ],
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.11",
    "@biomejs/biome": "2.5.9",
    "@resvg/resvg-js": "^2.6.2",
    "fallow": "^3.17.0",
    "lefthook": "^2.1.10",
    "lightningcss": "^1.33.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
